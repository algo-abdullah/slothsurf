# xAI Grok API Key (Get yours at https://console.x.ai/)
XAI_API_KEY=xai-your-api-key-here

# Grok Model Selection
# Options: grok-2-vision-1212 (recommended for visual browser grounding), grok-2-1212, grok-beta
GROK_MODEL=grok-2-vision-1212

# Browser Configuration
# Set to true if you don't want the browser window to pop up
HEADLESS=false

# Slow down actions in milliseconds (gives you time to watch the sloth navigate!)
BROWSER_SLOW_MO=1000
